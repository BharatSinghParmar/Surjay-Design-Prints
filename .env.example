# ── Site ───────────────────────────────────────────────────────────────────
# Canonical public URL. Drives canonical tags, OG/social previews, sitemap and
# structured data. Leave unset to fall back to the Vercel URL.
# Set this to https://surjaydesignprints.com once the domain is live.
NEXT_PUBLIC_SITE_URL=

# ── Lead delivery (contact form, quote modal, newsletter) ──────────────────
# Destination inbox. Defaults to site.email if unset.
LEAD_INBOX=

# Optional: post leads to a CRM/Zapier/Slack webhook instead of email.
# LEAD_WEBHOOK_URL=

# ── Admin Design Catalogue ─────────────────────────────────────────────────
# Session-cookie signing secret. REQUIRED in production (the app throws without it).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ── Production storage (local dev needs none — it uses .data/ + public/uploads) ─
# When you deploy to Vercel, provision these and the store/upload modules swap
# their local-JSON / filesystem drivers for these:
#
# Vercel Blob — file storage (Vercel dashboard → Storage → Blob)
# BLOB_READ_WRITE_TOKEN=
#
# Postgres — design + admin metadata (e.g. Neon via the Vercel Marketplace)
# DATABASE_URL=
