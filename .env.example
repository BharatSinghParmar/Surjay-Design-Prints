# ── Site ───────────────────────────────────────────────────────────────────
# Canonical public URL. Drives canonical tags, OG/social previews, sitemap and
# structured data. Leave unset to fall back to the Vercel URL.
# The custom domain is live; src/data/site.ts already defaults to it. Set this
# only to point a staging deploy somewhere else.
NEXT_PUBLIC_SITE_URL=

# ── Lead delivery (contact form, quote modal, newsletter) ──────────────────
# Destination inbox for every website enquiry.
LEAD_INBOX=

# Delivery provider, in priority order. With none of these set, the server
# validates and rate-limits the submission and the browser completes delivery
# via the default relay (which blocks datacenter IPs, so it cannot be called
# from a serverless function).
#
# 1. Webhook — post leads to a CRM/Zapier/Slack endpoint.
# LEAD_WEBHOOK_URL=
#
# 2. Resend — proper transactional email, free tier ~3,000/month.
#    Recommended upgrade: delivery happens fully server-side.
#    Sign up at resend.com, create an API key, then set:
# RESEND_API_KEY=
# MAIL_FROM="Surjay Website <onboarding@resend.dev>"

# ── Admin Design Catalogue ─────────────────────────────────────────────────
# Local development needs none of these: it uses .data/ and public/uploads.
# Production needs all three.

# 1. Session-cookie signing secret. REQUIRED in production — the app throws
#    without it. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# 2. Admin accounts, as JSON. Password hashes only, never plain text.
#    Generate the exact value with:  node scripts/create-admin.mjs
#    Kept out of Blob storage on purpose — Blob objects are publicly readable.
#    ADMIN_USERS=[{"email":"owner@example.com","name":"Ajay Soni","hash":"<salt>:<hash>"}]
ADMIN_USERS=

# 3. Vercel Blob — stores the uploaded design files (images and PDFs). Added
#    automatically when you create a Blob store in the Vercel dashboard
#    (Storage -> Blob -> Connect Project), so you rarely set it by hand.
# BLOB_READ_WRITE_TOKEN=

# 4. Postgres — stores the design records. Added automatically when you create a
#    Neon database in the Vercel dashboard (Storage -> Neon -> Connect Project).
#    Tables are created on first use; there is no migration step.
#    Without it the catalogue falls back to Blob JSON, then to local files.
# DATABASE_URL=

# ── Analytics & Search Console ─────────────────────────────────────────────
# GA4 measurement ID. Leave unset and NO analytics script is requested at all —
# src/components/Analytics.tsx renders nothing. Set it in Vercel to switch
# tracking on; a redeploy is required because NEXT_PUBLIC_ vars are inlined at
# build time.
#
# If you set this, /privacy must keep saying that analytics is in use. The two
# are expected to agree.
NEXT_PUBLIC_GA_ID=

# Google Search Console ownership token, HTML-tag method. Paste only the
# content value, not the whole meta tag. Unset means no meta tag is emitted.
# Not needed if the domain was verified via DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
